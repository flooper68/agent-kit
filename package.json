{
  "name": "agent-kit",
  "type": "module",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "check": "bun run lint && bun run format:check && bun run typecheck && bun run build",
    "dev": "bun run --filter '@agent-kit/server' --filter '@agent-kit/web' dev",
    "dev:server": "bun run --cwd apps/server dev",
    "dev:web": "bun run --cwd apps/web dev",
    "dev:storybook": "bun run --cwd apps/storybook dev",
    "dev:codebase-researcher": "bun run --cwd apps/local-agent dev:codebase-researcher",
    "dev:web-researcher": "bun run --cwd apps/local-agent dev:web-researcher",
    "dev:mock-agent": "bun run --cwd apps/local-agent dev:mock-agent",
    "dev:claude-cli": "bun run --cwd apps/local-agent dev:claude-cli",
    "dev:claude-assistant-opus": "bun run --cwd apps/local-agent dev:claude-assistant-opus",
    "dev:claude-assistant-sonnet": "bun run --cwd apps/local-agent dev:claude-assistant-sonnet",
    "build": "bun run build:ui && bun run build:web && bun run build:server && bun run build:local-agent",
    "build:codebase-researcher": "bun run --cwd apps/local-agent build:codebase-researcher",
    "build:web-researcher": "bun run --cwd apps/local-agent build:web-researcher",
    "build:mock-agent": "bun run --cwd apps/local-agent build:mock-agent",
    "build:claude-cli": "bun run --cwd apps/local-agent build:claude-cli",
    "build:claude-assistant-opus": "bun run --cwd apps/local-agent build:claude-assistant-opus",
    "build:claude-assistant-sonnet": "bun run --cwd apps/local-agent build:claude-assistant-sonnet",
    "build:ui": "bun run --cwd packages/ui build",
    "build:web": "bun run --cwd apps/web build",
    "build:server": "bun run --cwd apps/server build",
    "build:local-agent": "bun run --cwd apps/local-agent build",
    "build:storybook": "bun run --cwd apps/storybook build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "bun run typecheck:ui && bun run typecheck:server && bun run typecheck:web && bun run typecheck:storybook && bun run typecheck:local-agent",
    "typecheck:ui": "bun run --cwd packages/ui tsc --noEmit",
    "typecheck:server": "bun run --cwd apps/server tsc --noEmit",
    "typecheck:web": "bun run --cwd apps/web tsc --noEmit",
    "typecheck:storybook": "bun run --cwd apps/storybook tsc --noEmit",
    "typecheck:local-agent": "bun run --cwd apps/local-agent tsc --noEmit",
    "clean": "rm -rf node_modules packages/*/node_modules apps/*/node_modules packages/*/dist apps/*/dist",
    "db:generate": "bun run --cwd apps/server db:generate",
    "db:migrate": "bun run --cwd apps/server db:migrate",
    "db:push": "bun run --cwd apps/server db:push",
    "db:studio": "bun run --cwd apps/server db:studio",
    "db:reset": "bun run --cwd apps/server db:reset",
    "db:seed": "bun run --cwd apps/server db:seed"
  },
  "devDependencies": {
    "@eslint/js": "9.17.0",
    "@playwright/test": "1.57.0",
    "autoprefixer": "10.4.23",
    "eslint": "9.17.0",
    "eslint-config-prettier": "9.1.0",
    "eslint-plugin-react": "7.37.2",
    "eslint-plugin-react-hooks": "5.1.0",
    "globals": "15.14.0",
    "playwright": "1.57.0",
    "postcss": "8.5.6",
    "prettier": "3.4.2",
    "tailwindcss": "3.4.17",
    "typescript": "5.7.2",
    "typescript-eslint": "8.19.0"
  },
  "dependencies": {
    "gpt-tokenizer": "^3.4.0"
  }
}
