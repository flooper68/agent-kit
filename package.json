{
  "name": "agent-kit",
  "type": "module",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "bun run --filter '*' dev",
    "dev:server": "bun run --cwd apps/server dev",
    "dev:web": "bun run --cwd apps/web dev",
    "dev:storybook": "bun run --cwd packages/ui storybook",
    "build": "bun run build:ui && bun run build:web && bun run build:server",
    "build:ui": "bun run --cwd packages/ui build",
    "build:web": "bun run --cwd apps/web build",
    "build:server": "bun run --cwd apps/server build",
    "build:storybook": "bun run --cwd packages/ui build-storybook",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --build",
    "clean": "rm -rf node_modules packages/*/node_modules apps/*/node_modules packages/*/dist apps/*/dist",
    "db:generate": "bun run --cwd apps/server db:generate",
    "db:migrate": "bun run --cwd apps/server db:migrate",
    "db:push": "bun run --cwd apps/server db:push",
    "db:studio": "bun run --cwd apps/server db:studio",
    "db:reset": "bun run --cwd apps/server db:reset",
    "db:seed": "bun run --cwd apps/server db:seed"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.57.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.14.0",
    "playwright": "^1.57.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.0"
  }
}
