{
  "name": "@agent-kit/server",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "start": "bun run dist/index.js",
    "db:generate": "bun --env-file ../../.env drizzle-kit generate",
    "db:migrate": "bun --env-file ../../.env drizzle-kit migrate",
    "db:push": "bun --env-file ../../.env drizzle-kit push",
    "db:studio": "bun --env-file ../../.env drizzle-kit studio",
    "db:reset": "bun --env-file ../../.env src/db/reset.ts",
    "db:seed": "bun --env-file ../../.env src/db/seed.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.1",
    "fastify": "^5.2.1",
    "postgres": "^3.4.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "drizzle-kit": "^0.31.8",
    "typescript": "^5.7.2"
  }
}
