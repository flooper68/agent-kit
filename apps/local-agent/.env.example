# Shared Configuration
SERVER_URL=https://your-server.example.com

# Codebase Researcher
CODEBASE_RESEARCHER_AGENT_API_KEY=ak_local_xxx
CODEBASE_RESEARCHER_AGENT_ID=codebase-researcher
CODEBASE_RESEARCHER_WORKSPACE=./workspace
CODEBASE_RESEARCHER_WORKING_DIRECTORY=/workspace
CODEBASE_RESEARCHER_MODEL=
# Defaults: MAX_THINKING_TOKENS=10000, INCLUDE_PARTIAL_MESSAGES=true (set in code)
CODEBASE_RESEARCHER_MAX_THINKING_TOKENS=
CODEBASE_RESEARCHER_INCLUDE_PARTIAL_MESSAGES=

# Web Researcher
WEB_RESEARCHER_AGENT_API_KEY=ak_local_xxx
WEB_RESEARCHER_AGENT_ID=web-researcher
WEB_RESEARCHER_MODEL=
# Defaults: MAX_THINKING_TOKENS=10000, INCLUDE_PARTIAL_MESSAGES=true (set in code)
WEB_RESEARCHER_MAX_THINKING_TOKENS=
WEB_RESEARCHER_INCLUDE_PARTIAL_MESSAGES=
WEB_RESEARCHER_HTTP_PROXY=
WEB_RESEARCHER_HTTPS_PROXY=

# Mock Agent
MOCK_AGENT_AGENT_API_KEY=ak_local_xxx
MOCK_AGENT_AGENT_ID=mock-agent
MOCK_AGENT_DELAY_MS=100
MOCK_AGENT_THINKING_ENABLED=true
MOCK_AGENT_TOOL_CALLS=2
